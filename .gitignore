# OpenMC generated outputs
*.h5
statepoint.*
summary.h5
tallies.out
source.*.h5
particle_*.h5

# OpenMC inputs are generated by scripts; keep the scripts, not the XML
cardinal/openmc/*.xml

# MOOSE / Exodus / VTK
*.e
*.e-s*
*.exo
*.vtk
*.vtu
*.pvtu
*.pvd

# NekRS field and checkpoint files
*.fld
*.f0*
*.nek5000
*.re2.bak
logfile*
.cache/

# Build artifacts and binaries
build/
*.o
*.so
*.dylib
*.a

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Scratch
scratch/
*.log
!results/*.log

# Generated run directories (inputs are regenerated by scripts/run_openmc.sh)
run/

# Coupled-case OpenMC XML is generated by make_coupled_model.py
cardinal/coupling/*.xml

# Cardinal per-run output CSVs (curated copies live in results/)
cardinal/**/*_out.csv
cardinal/**/*_out_*.csv

# NekRS mesh build intermediates (fluid.re2 IS tracked; these regenerate it)
cardinal/nekrs/fluid_in.e
cardinal/nekrs/convert.exo
