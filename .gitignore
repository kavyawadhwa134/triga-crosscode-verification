# OpenMC generated outputs
*.h5
statepoint.*
summary.h5
tallies.out
source.*.h5
particle_*.h5

# OpenMC inputs are generated by scripts; keep the scripts, not the XML
cardinal/openmc/*.xml

# MOOSE / Exodus / VTK
*.e
*.e-s*
*.exo
*.vtk
*.vtu
*.pvtu
*.pvd

# NekRS field and checkpoint files
*.fld
*.f0*
*.nek5000
*.re2.bak
logfile*
.cache/

# Build artifacts and binaries
build/
*.o
*.so
*.dylib
*.a

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Scratch
scratch/
*.log
!results/*.log

# Generated run directories (inputs are regenerated by scripts/run_openmc.sh)
run/

# Coupled-case OpenMC XML is generated by make_coupled_model.py
cardinal/coupling/*.xml

# Cardinal per-run output CSVs (curated copies live in results/)
cardinal/**/*_out.csv
cardinal/**/*_out_*.csv

# NekRS mesh build intermediates (fluid.re2 IS tracked; these regenerate it)
cardinal/nekrs/fluid_in.e
cardinal/nekrs/convert.exo

# Local assistant configuration (not part of the project)
CLAUDE.md
AGENTS.md
.claude/
docs/CODEX_HANDOFF.md

# Internal working notes kept locally only
PCM_STATUS.md
PCM_WORKFLOW.md
spec/

# GeN-Foam / OpenFOAM run outputs
genfoam/*/[1-9]*/
genfoam/*/processor*/
genfoam/*/log.*
genfoam/*/constant/polyMesh/
genfoam/*/constant/*/polyMesh/
genfoam/lattice/*.xml
genfoam/lattice/statepoint.*.h5
genfoam/lattice/summary.h5
genfoam/lattice/mgxs/
!genfoam/lattice/mgxs_2g_data.h5
