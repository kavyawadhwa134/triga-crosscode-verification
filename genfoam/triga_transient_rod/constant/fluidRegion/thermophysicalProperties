FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       polynomial;
    thermo          hPolynomial;
    equationOfState icoPolynomial; //perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

pRef            100000;

// TRIGA Tier-1: liquid water at ~300 K (constant-property placeholders;
// Tier-2 replaces with temperature polynomials).
mixture
{
    specie
    {
        molWeight       18.015;
    }
    equationOfState
    {
        rhoCoeffs<8>    (997 0 0 0 0 0 0 0);
    }
    thermodynamics
    {
        CpCoeffs<8>
        (
            4182
            0
            0
            0
            0
            0
            0
            0
        );
        Hf      0;
        Sf      0;
    }
    transport
    {
        muCoeffs<8>     (8.9e-4 0 0 0 0 0 0 0);
        kappaCoeffs<8>  (0.615 0 0 0 0 0 0 0);
    }
}

