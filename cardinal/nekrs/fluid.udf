#include "udf.hpp"

// NekRS 26 compiles host and device UDF code from this one source file.
// PCM_STANDALONE_FLUX is the uniform non-dimensional clad heat flux used by
// the standalone fluid model. Coupled runs replace it with MOOSE/OpenMC data.
#define PCM_STANDALONE_FLUX 0.009946

#ifdef __okl__

void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    // Side 2: uniform axial inlet velocity, U* = 1.
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 1.0;
  } else if (isField("scalar temperature")) {
    // Side 2: inlet temperature, T* = 0 (293 K).
    bc->sScalar = 0.0;
  }
}

void udfNeumann(bcData *bc)
{
  if (isField("scalar temperature")) {
#ifdef PCM_COUPLED
    bc->flux = bc->usrwrk[bc->idM];
#else
    bc->flux = PCM_STANDALONE_FLUX;
#endif
  }
}

#endif

void UDF_Setup()
{
  // The NekRS 26 solver initializes fields. The inlet and wall conditions
  // above establish the intended flow and thermal state without legacy host
  // mirrors, which this version no longer provides.
}
