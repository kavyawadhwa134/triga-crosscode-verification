// pcM NekRS boundary conditions, TRIGA coolant subchannel.
//
// PCM_STANDALONE_FLUX is the uniform non-dimensional wall heat flux used when
// running NekRS on its own:
//     q''* = q'' / (rho * Cp * U * dT) = 0.009946
// corresponding to 2083.33 W over the pin surface. Under Cardinal this is
// replaced by the per-point flux MOOSE/OpenMC computes, passed in usrwrk.

#define PCM_STANDALONE_FLUX 0.009946

void velocityDirichletConditions(bcData * bc)
{
  bc->u = 0.0;
  bc->v = 0.0;
  bc->w = 1.0;   // uniform axial inlet velocity, U* = 1
}

void scalarDirichletConditions(bcData * bc)
{
  bc->s = 0.0;   // inlet temperature, T* = 0 (293 K)
}

void scalarNeumannConditions(bcData * bc)
{
#ifdef PCM_COUPLED
  bc->flux = bc->usrwrk[bc->idM];
#else
  bc->flux = PCM_STANDALONE_FLUX;
#endif
}
